# Google Gemini API key — server-side only. NEVER prefix with NEXT_PUBLIC_.
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gemini model to use for assessment evaluation. Configurable so it can be
# bumped to a newer model without any code changes.
GEMINI_MODEL=gemini-3.5-flash

# Maximum accepted upload size, in megabytes.
MAX_UPLOAD_SIZE_MB=15

# When "true", the /api/assessment/evaluate route returns a deterministic
# mock evaluation instead of calling Gemini — useful for frontend development
# without burning real API quota. Never set true in production.
USE_MOCK_ASSESSMENT_EVALUATION=false

# Secret used to sign session JWTs (src/lib/auth/session.ts). REQUIRED —
# auth routes throw if this is unset. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never expose this to the client.
SESSION_SECRET=

# Postgres connection string — the source of truth for users/enrollments
# (src/lib/db/schema.ts). REQUIRED in every environment except `npm test`
# (which uses an embedded real Postgres engine, see src/lib/db/client.ts).
# Server-side only — never prefix with NEXT_PUBLIC_.
#
# Production/staging: a Render Postgres "External Database URL", set in
# Vercel's Project Settings -> Environment Variables (NOT in this repo).
# Local development: run `docker compose up -d` (see docker-compose.yml),
# then use the connection string below.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Local Docker Postgres example:
# DATABASE_URL=postgresql://gurukul:gurukul@localhost:5432/gurukul
